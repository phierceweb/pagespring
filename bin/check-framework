#!/usr/bin/env python3
"""Refuse code that hand-rolls what pf-core already provides.

Every rule names its replacement. Exemptions are per file with a reason, never
a blanket skip.

    bin/check-framework            # the whole package
    bin/check-framework a.py b.py  # just these
"""

from __future__ import annotations

import ast
import io
import re
import sys
import tokenize
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "src" / "pagespring"

# Modules pf-core (or pagespring's own shim) replaces outright.
BANNED_IMPORTS = {
    "logging": (
        "pf_core.log.get_logger(__name__)",
        "structured events, and the project's log level and file wiring",
    ),
    "dotenv": (
        "pf_core.config.load_env",
        "entry points already load .env; a second loader fights the first",
    ),
    "requests": ("pagespring.http", "the crawl User-Agent, size caps, retries and the SSRF guard"),
    "httpx": ("pagespring.http", "the crawl User-Agent, size caps, retries and the SSRF guard"),
    "aiohttp": ("pagespring.http", "fetching is stdlib urllib through one shim"),
    "urllib3": ("pagespring.http", "fetching is stdlib urllib through one shim"),
}

# Builtins that must not be raised from library code.
BANNED_RAISES = {
    "Exception": ("a pf_core.exceptions class", "an unsearchable log key and no context"),
    "RuntimeError": ("pf_core.exceptions.PreconditionError", "'required state not met'"),
    "ValueError": ("pf_core.exceptions.InvalidInputError", "'the caller passed something bad'"),
}

# (name, pattern, what to use, why). `name` is what an exemption refers to.
BANNED_CALLS = [
    (
        "env-read",
        re.compile(r"\bos\.(environ|getenv)\b"),
        "pf_core.utils.env.resolve_int/resolve_str/resolve_bool",
        "malformed values warn and fall back instead of crashing — .ai/rules/config-driven.md",
    ),
    (
        "print",
        re.compile(r"(?<![\w.])print\s*\("),
        "pf_core.log.get_logger(__name__), or typer.echo at the CLI boundary",
        "print() in a library is output nobody can level, filter or redirect",
    ),
    (
        "atomic-write",
        re.compile(r"\bos\.replace\s*\("),
        "pf_core.utils.io.atomic_write_text / _json / _bytes",
        "the temp-file-then-rename dance is already written and tested",
    ),
]

# {(rule, path relative to SRC): why it does not apply}. The key is the whole
# path — two files can share a basename.
EXEMPT: dict[tuple[str, str], str] = {
    ("print", "cli.py"): "the CLI entry point is where user-facing output belongs",
}


def code_only(text: str) -> dict[int, str]:
    """Each line with its comments and string literals blanked out, so a
    docstring naming ``os.environ`` documents the rule instead of breaking it."""
    lines = {n: line for n, line in enumerate(text.splitlines(), start=1)}
    try:
        tokens = list(tokenize.generate_tokens(io.StringIO(text).readline))
    except (tokenize.TokenError, IndentationError):
        return lines
    for token in tokens:
        if token.type not in (tokenize.STRING, tokenize.COMMENT):
            continue
        (r1, c1), (r2, c2) = token.start, token.end
        for row in range(r1, r2 + 1):
            line = lines.get(row, "")
            start = c1 if row == r1 else 0
            end = c2 if row == r2 else len(line)
            lines[row] = line[:start] + " " * (end - start) + line[end:]
    return lines


def _writes_json_unsafely(node: ast.AST) -> bool:
    """A ``.write_text``/``.write_bytes`` whose payload came from ``json.dumps``;
    a torn write leaves a file that parses as neither record."""
    if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Attribute):
        return False
    if node.func.attr not in ("write_text", "write_bytes"):
        return False
    return any(
        isinstance(inner, ast.Call)
        and isinstance(inner.func, ast.Attribute)
        and inner.func.attr in ("dumps", "dump")
        and isinstance(inner.func.value, ast.Name)
        and inner.func.value.id == "json"
        for arg in node.args
        for inner in ast.walk(arg)
    )


def check(path: Path) -> list[str]:
    """Every framework rule this file breaks, each naming its replacement."""
    text = path.read_text(encoding="utf-8")
    rel = path.relative_to(ROOT) if ROOT in path.parents else path
    found: list[str] = []

    for node in ast.walk(ast.parse(text)):
        seen: list[tuple[str, int]] = []
        if isinstance(node, ast.Import):
            seen = [(a.name, node.lineno) for a in node.names]
        elif isinstance(node, ast.ImportFrom) and node.module:
            seen = [(node.module, node.lineno)]
        for name, line in seen:
            hit = BANNED_IMPORTS.get(name) or BANNED_IMPORTS.get(name.split(".")[0])
            if hit:
                found.append(f"{rel}:{line}: imports {name!r} — use {hit[0]} ({hit[1]})")

        if isinstance(node, ast.Raise) and node.exc is not None:
            call = node.exc.func if isinstance(node.exc, ast.Call) else node.exc
            raised = getattr(call, "id", None)
            if raised in BANNED_RAISES:
                use, why = BANNED_RAISES[raised]
                found.append(f"{rel}:{node.lineno}: raises {raised} — use {use} ({why})")

        if _writes_json_unsafely(node):
            found.append(
                f"{rel}:{node.lineno}: writes JSON with write_text — use "
                "pf_core.utils.io.atomic_write_text / _json "
                "(a torn write leaves a file that parses as neither record)"
            )

    for rule, pattern, use, why in BANNED_CALLS:
        key = str(path.relative_to(SRC)) if SRC in path.parents else path.name
        if (rule, key) in EXEMPT:
            continue
        for line_no, line in code_only(text).items():
            if pattern.search(line):
                found.append(f"{rel}:{line_no}: {line.strip()[:56]} — use {use} ({why})")
    return found


def main(argv: list[str]) -> int:
    given = [Path(a).resolve() for a in argv]
    paths = [p for p in given if p.suffix == ".py"] or sorted(SRC.rglob("*.py"))
    bad = [problem for p in paths if p.is_file() for problem in check(p)]
    if bad:
        print("Framework rules — pf-core already provides these:\n")
        for line in bad:
            print(f"  {line}")
        print(f"\n{len(bad)} to fix.")
        print("If pf-core genuinely does not cover a case, add an EXEMPT entry here with")
        print("the reason — never a blanket skip.")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
