#!/usr/bin/env bash
# Bootstrap pagespring: venv (Python 3.12+), editable install, .env, framework wiring (pw-setup).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
ok()   { echo "  ✓ $*"; }
info() { echo "  $*"; }

pick_python() {
  local p
  for p in python3.13 python3.12 python3; do
    p="$(command -v "$p" 2>/dev/null || true)"
    [[ -n "$p" ]] || continue
    if "$p" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
      echo "$p"; return 0
    fi
  done
  echo "No Python 3.12+ found. Install 3.12+ (e.g. brew install python@3.12)." >&2
  exit 1
}

if [[ ! -d .venv ]]; then
  PY="$(pick_python)"
  info "Creating .venv ($("$PY" --version | tr -d '\r'))"
  "$PY" -m venv .venv
  ok ".venv created"
else
  ok ".venv exists ($(.venv/bin/python --version | tr -d '\r'))"
fi

info "Installing (editable, with dev extras)..."
.venv/bin/python -m pip install --quiet --upgrade pip
GIT_TERMINAL_PROMPT=0 .venv/bin/python -m pip install -e ".[dev]"
ok "dependencies installed"

if [[ -f .env.example && ! -f .env ]]; then
  cp .env.example .env
  ok "copied .env.example -> .env"
fi

# Local pre-commit gate hooks if configured (CI is the backstop).
if [[ -f .pre-commit-config.yaml ]]; then
  .venv/bin/pre-commit install >/dev/null 2>&1 && ok "pre-commit hooks installed" || true
fi

# pw-setup (pw-foundation) links the framework docs under docs/, installs the starter
# rules into .ai/rules/ and points .claude/ and .cursor/ at .ai/. Last: it refuses (exit 1)
# when a real directory sits where a link goes, and says what to move.
.venv/bin/pw-setup
ok "pw-setup ran"

echo
echo "Setup complete. Try: bin/run --help"
