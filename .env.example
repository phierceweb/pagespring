# pagespring has no secrets — fetching is stdlib urllib against public docs.
# Settings below are optional overrides of pagespring.config.PagespringConfig
# (env vars win over the defaults). Copy to .env to use.

# Which file this is. Settings resolve from the project root's .env, which only
# an editable checkout has; an installed CLI must be pointed at one. Set in the
# environment, never here — it names the file, so it cannot be read from it.
# PAGESPRING_ENV_FILE=/etc/pagespring/.env

# Where the deliverable lands (default: incoming, relative to the directory you
# run from — `bin/run` cds to the project root first, an installed CLI does not).
# INCOMING_DIR=incoming

# Structured logging, inherited from pf-core (level default INFO; an empty
# LOG_FILE means file logging is off).
# LOG_LEVEL=INFO
# LOG_FILE=

# User-Agent for all fetches. Default identifies pagespring + its repo URL;
# override for a source that mishandles the tool UA.
# PAGESPRING_UA=pagespring/x.y (+https://github.com/phierceweb/pagespring)

# Size caps on fetched bodies, in bytes. They bound the decoded body as well as
# the wire read, so a compressed response cannot exhaust memory as it inflates.
# An overrun fails the acquire; raise the download cap if a real manual is
# being refused.
# PAGESPRING_MAX_TEXT_BYTES=26214400        # 25 MiB — HTML pages, sitemaps
# PAGESPRING_MAX_DOWNLOAD_BYTES=262144000   # 250 MiB — PDFs, archives, images

# Fetches refuse URLs resolving to private/loopback/link-local/unresolvable
# hosts (pf-core's SSRF guard). Set to 1 only for a deliberately internal
# source — an intranet docs site or a local mirror.
# URL_FETCH_ALLOW_PRIVATE=0

# Idle seconds before a queue-driven crawl is treated as stalled and bails with
# its remaining queue (the deliverable is then marked truncated). 0 disables.
# CRAWL_STALL_AFTER_S=300

# A same-source re-ingest or refresh that finds fewer than this percent of the
# pages already staged is refused and the staged manual kept; --replace accepts
# it (COLLAPSE_KEEP_PCT=0 disables the check). Manuals under COLLAPSE_MIN_PAGES
# pages are exempt. A crawl cut short by its page cap is always refused when the
# staged manual is larger and complete.
# COLLAPSE_KEEP_PCT=50
# COLLAPSE_MIN_PAGES=10
